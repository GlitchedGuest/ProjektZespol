                <ui:Label text="SFX" />
                <ui:Slider label="SFX" value="42" high-value="1" enabled="true" name="SFXSlider" show-input-field="false" fill="true" class="slider" style="width: 100%; align-items: flex-start;" />
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; width: 100%; height: 30%; min-height: 30%; max-height: 30%; align-content: flex-start;">
                    <ui:VisualElement style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5%; padding-right: 4px; padding-bottom: 5%; padding-left: 4px; top: 0; bottom: 0; left: 0; right: 0; width: 50%; height: 300px; min-width: 50%; max-width: 50%; max-height: 100px; min-height: 100px; align-self: center;">
                        <ui:Button text="Delete Save" name="DeleteSaveButton" class="stylprzyciskow" style="height: 200%; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; width: 80%; top: 0; left: 0; right: 0; bottom: 0; position: relative; align-items: center; justify-content: space-between; align-self: center; align-content: center;" />
                    </ui:VisualElement>
                    <ui:Toggle label="AutoSave&#10;" name="AutoSavetoggle" value="true" style="width: 50%; height: 100%; align-items: center; right: 0; left: 0; justify-content: flex-start; align-content: flex-start; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-left: 5%; top: 10%;" />
                </ui:VisualElement>
