<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=d90b63a1271321f4682975c65f5a3b7b&amp;type=3#MainMenu" />
    <ui:VisualElement name="Panel" class="panel" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/GuiArt/BorderStyle2.png?fileID=2800000&amp;guid=5132d40b35184cd4c9331c09194e71d8&amp;type=3#BorderStyle2&quot;); -unity-background-scale-mode: scale-and-crop; background-size: 0% 0; background-color: rgba(0, 0, 0, 0.79); -unity-slice-left: 300; -unity-slice-top: 300; -unity-slice-right: 300; -unity-slice-bottom: 300; -unity-slice-scale: 0.3px;">
        <ui:VisualElement name="Main" class="container" style="flex-grow: 1; margin-top: 5%; margin-left: 0; margin-bottom: 5%; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; transform-origin: top; padding-top: 5%; padding-right: 5%; padding-bottom: 5%; padding-left: 5%; -unity-font-definition: url(&quot;project://database/Assets/Font/Bitfantasy.ttf?fileID=12800000&amp;guid=174460ffafcf09346901972a60e931d6&amp;type=3#Bitfantasy&quot;); background-color: rgba(0, 0, 0, 0);">
            <ui:VisualElement name="ButtonContainer" class="buttoncontainer" style="flex-grow: 1; width: 100%; height: auto; color: rgba(0, 0, 0, 0); background-color: rgba(0, 0, 0, 0); -unity-text-align: upper-left; align-items: center; transform-origin: center; -unity-font-definition: url(&quot;project://database/Assets/Font/NotJamBlkltr16.ttf?fileID=12800000&amp;guid=b737cea42b1bc594ea1a1bbbb71da7a4&amp;type=3#NotJamBlkltr16&quot;);">
                <ui:Label text="Timeless" style="margin-bottom: 4px; font-size: 200px; margin-top: 4%; color: rgb(240, 184, 46); -unity-text-align: upper-center;" />
                <ui:Button text="Play" name="StartButton" class="stylprzyciskow" style="background-image: url(&quot;project://database/Assets/UI/GuiArt/BorderStyle1.png?fileID=2800000&amp;guid=55b0fd22875fad945891e5d09bce7254&amp;type=3#BorderStyle1&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
                <ui:Button text="Settings" name="SettingsButton" class="stylprzyciskow" />
                <ui:Button text="Exit to Desktop" parse-escape-sequences="false" name="QuitButton" class="stylprzyciskow" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Settings" class="container hidden" style="flex-grow: 1; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; margin-top: 10%; margin-bottom: 10%; overflow: hidden; background-color: rgba(0, 0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/Font/NotJamBlkltr16.ttf?fileID=12800000&amp;guid=b737cea42b1bc594ea1a1bbbb71da7a4&amp;type=3#NotJamBlkltr16&quot;);">
            <ui:Label text="Settings" style="margin-bottom: 0%; color: rgb(240, 184, 46); font-size: 80px;" />
            <ui:ScrollView horizontal-scroller-visibility="Hidden" style="width: 80%; height: 65%; justify-content: space-between; align-items: stretch; align-self: center; align-content: stretch;">
                <ui:DropdownField label="Resolution" name="Res" choices="1920x1080,1280x720,800x600" index="0" style="width: 100%; min-width: 100%; max-width: 100%; margin-top: 2%; margin-bottom: 2%;" />
                <ui:Toggle label="Fullscreen" name="FullScreen" style="justify-content: flex-start; align-content: flex-start; align-self: center; margin-bottom: 0%;" />
