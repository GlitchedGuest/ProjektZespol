.color {
    background-color: rgba(71, 71, 71, 0.71);
}

.text {
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
}

.btncolor:hover {
    background-color: rgb(0, 35, 152);
    transition-duration: 0.25s;
}

.btncolor {
    background-color: rgb(34, 34, 34);
}

.mariginbottom10 {
    margin-bottom: 10px;
}

#AmoutSlider #unity-tracker {
    background-color: rgb(36, 36, 36);
    width: auto;
    height: 100%;
    justify-content: flex-start;
    align-self: auto;
    flex-grow: 1;
    top: 0;
    left: auto;
    right: auto;
    bottom: auto;
    align-items: stretch;
    position: relative;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-bottom-left-radius: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

#AmoutSlider #unity-dragger {
    background-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 10%;
    border-top-right-radius: 10%;
    border-bottom-right-radius: 10%;
    border-bottom-left-radius: 10%;
    top: -20%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    height: 140%;
    width: 6%;
}

#AmoutSlider Label {
    display: none;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.navbuttonborder {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
}

#LvlProggres .unity-progress-bar__background {
    background-color: rgb(36, 5, 161);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    flex-grow: 1;
    height: 100%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

#LvlProggres .unity-progress-bar__progress {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(255, 197, 0);
    flex-grow: 1;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#LvlProggres .unity-progress-bar__container {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.f3color {
    background-color: rgba(36, 255, 0, 0.71);
}

.f2color {
    background-color: rgba(255, 0, 0, 0.71);
}
.skill-node {
    width: 90px;
    height: 90px;
    border-width: 2px;
    border-color: black;
    border-radius: 10px;
    background-color: rgb(120, 120, 255);
    transition: background-color 0.2s ease-in-out;
    margin-top: 0;
    margin-right: 20px;
    margin-bottom: 40px;
    margin-left: 20px;
}

.skill-node:hover {
    transition-duration: 1s;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(128, 111, 54);
    border-right-color: rgb(128, 111, 54);
    border-top-color: rgb(128, 111, 54);
    border-bottom-color: rgb(128, 111, 54);
}
