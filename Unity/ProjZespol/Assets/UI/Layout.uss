.color {
    background-color: rgba(48, 48, 48, 0.71);
}

.text {
    -unity-font-style: bold;
    font-size: 20px;
    -unity-text-outline-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
}

.btncolor:hover {
    background-color: rgb(0, 35, 152);
    scale: 1.05 1.1;
    transition-duration: 0.25s;
}

.btncolor {
    background-color: rgb(34, 34, 34);
}

.mariginbottom10 {
    margin-bottom: 10px;
}
