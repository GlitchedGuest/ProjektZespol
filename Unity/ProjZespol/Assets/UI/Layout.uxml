<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Layout.uss?fileID=7433441132597879392&amp;guid=7ea33738955c9e342a0a8527e76837e4&amp;type=3#Layout" />
    <ui:VisualElement name="Background" style="flex-grow: 1;">
        <ui:VisualElement name="Top" class="color" style="flex-grow: 1; position: absolute; height: 10%; width: 100%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-bottom-width: 2px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; align-self: flex-start; flex-direction: row; align-items: center; justify-content: flex-start; flex-wrap: nowrap;">
            <ui:VisualElement name="cbbleicon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/MCCobblestone.png?fileID=2800000&amp;guid=842aca1794906e64eb8898b2b81fc18d&amp;type=3#MCCobblestone&quot;); height: 50%; width: 3%; align-self: center; justify-content: center; align-items: flex-start; flex-shrink: 0; left: 10%;" />
            <ui:Label text="Curr&#10;" name="Currency" class="text" style="height: 100%; width: auto; left: 10%; position: relative; justify-content: flex-start; align-self: center; top: auto; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; align-content: flex-start; white-space: nowrap; -unity-text-align: middle-left; font-size: 40px;" />
            <ui:VisualElement name="goldicon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/gold.png?fileID=2800000&amp;guid=813f44c4ede4bf84e92e2c3628633e97&amp;type=3#gold&quot;); height: 50%; width: 3%; align-self: center; justify-content: center; align-items: flex-start; flex-shrink: 0; left: 30%; position: absolute;" />
            <ui:Label text="Gold" name="Money" class="text" style="height: 100%; width: auto; left: 33.5%; position: absolute; justify-content: center; align-self: center; top: auto; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; align-content: flex-start; white-space: nowrap; -unity-text-align: middle-left; font-size: 40px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Bottom" class="color" style="flex-grow: 1; height: 10%; width: 100%; position: absolute; top: 90%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-top-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px;">
            <ui:Label text="Stat1" name="Stat1" class="text" style="height: auto; width: 6%; left: 20%; position: absolute;" />
            <ui:Label text="Stat2&#10;" name="Stat2" class="text" style="height: auto; width: 6%; left: 50%; position: absolute;" />
            <ui:Label text="Stat3&#10;" name="Stat3" class="text" style="height: auto; width: 6%; left: 80%; position: absolute;" />
        </ui:VisualElement>
        <ui:VisualElement name="Stats" style="flex-grow: 1; position: absolute; top: 11%; left: 66%; width: 34%; height: 78%; background-color: rgb(0, 0, 72); border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 10px;">
            <ui:Button text="Zasoby" name="btn" emoji-fallback-support="false" class="text btncolor" style="position: relative; top: 15%; left: -12%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; width: 30%;" />
            <ui:Button text="Func2" name="btn2" class="color text btncolor" style="position: relative; top: 30%; left: -12%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; width: 30%;" />
            <ui:Button text="Func3" name="btn3" class="color text btncolor" style="position: relative; top: 45%; left: -12%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; width: 30%;" />
            <ui:VisualElement name="Content" style="flex-grow: 1; position: absolute; width: 78%; height: 100%; align-items: center; align-self: flex-end; align-content: flex-start; justify-content: center;">
                <ui:Label text="Napis" name="Napis" class="text" style="height: auto; width: 30%; left: auto; position: absolute; top: 30%;" />
                <ui:Button text="Sprzedaj 1 szt." name="sell1" class="btncolor text mariginbottom10" style="top: auto; visibility: visible;" />
                <ui:Button text="Sprzedaj 50%" name="sell50" class="btncolor text mariginbottom10" style="visibility: visible;" />
                <ui:Button text="Sprzedaj 100%" name="sell100" class="btncolor text mariginbottom10" style="visibility: visible;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
