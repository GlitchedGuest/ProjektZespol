        <ui:VisualElement name="Top" class="color" style="flex-grow: 1; position: absolute; height: 10%; width: 100%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-bottom-width: 2px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;" />
