<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Layout.uss?fileID=7433441132597879392&amp;guid=7ea33738955c9e342a0a8527e76837e4&amp;type=3#Layout" />
    <ui:VisualElement name="Background" style="flex-grow: 1;">
        <ui:VisualElement name="Top" class="color" style="flex-grow: 1; position: absolute; height: 10%; width: 100%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-bottom-width: 2px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; flex-direction: row; align-items: center; justify-content: flex-start; flex-wrap: nowrap;">
            <ui:VisualElement name="LvlProggres" style="flex-grow: 0; left: 5%; background-size: 100% 100%; position: relative; width: 20%;">
                <ui:ProgressBar value="20" name="lvlprog" style="width: auto; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Label text="100" name="lvlNumber" style="overflow: visible; position: absolute; -unity-font-style: bold; background-color: rgb(255, 200, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; width: 100px; font-size: 40px; -unity-text-align: upper-center; top: -50%; right: auto; left: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-self: center;" />
            </ui:VisualElement>
            <ui:VisualElement name="cbbleicon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/MCCobblestone.png?fileID=2800000&amp;guid=842aca1794906e64eb8898b2b81fc18d&amp;type=3#MCCobblestone&quot;); height: 50%; width: 3%; align-self: center; justify-content: center; align-items: flex-start; flex-shrink: 0; left: 10%;" />
            <ui:Label text="Curr&#10;" name="Currency" class="text" style="height: 100%; width: auto; left: 10%; position: relative; justify-content: flex-start; align-self: center; top: auto; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; align-content: flex-start; white-space: nowrap; -unity-text-align: middle-left; font-size: 40px;" />
            <ui:VisualElement name="goldicon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/gold.png?fileID=2800000&amp;guid=813f44c4ede4bf84e92e2c3628633e97&amp;type=3#gold&quot;); height: 50%; width: 3%; align-self: center; justify-content: center; align-items: flex-start; flex-shrink: 0; left: 50%; position: absolute;" />
            <ui:Label text="Gold" name="Money" class="text" style="height: 100%; width: auto; left: 53.5%; position: absolute; justify-content: center; align-self: center; top: auto; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; align-content: flex-start; white-space: nowrap; -unity-text-align: middle-left; font-size: 40px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Bottom" class="color" style="flex-grow: 1; height: 10%; width: 100%; position: absolute; top: 90%; border-left-color: rgb(0, 0, 72); border-right-color: rgb(0, 0, 72); border-top-color: rgb(0, 0, 72); border-bottom-color: rgb(0, 0, 72); border-top-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px;" />
        <ui:VisualElement name="Stats" style="flex-grow: 1; position: absolute; top: 11%; left: 66%; width: 34%; height: 78%; background-color: rgb(0, 0, 76); border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: flex-start; flex-direction: column;">
            <ui:Button text="Zasoby" name="btn" emoji-fallback-support="false" class="text btncolor navbuttonborder" style="position: relative; top: 0%; left: 0%; width: 22%; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; justify-content: flex-start; align-self: auto; align-content: flex-start; align-items: stretch; flex-direction: column; height: 10%;" />
            <ui:Button text="Fabryki" name="btn2" class="color text btncolor navbuttonborder" style="position: relative; top: 0%; left: 0%; width: 22%; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0; height: 10%;" />
            <ui:Button text="Func3" name="btn3" class="color text btncolor navbuttonborder" style="position: relative; top: 0%; left: 0%; width: 22%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 10%;" />
            <ui:VisualElement name="Content" style="flex-grow: 1; position: absolute; width: 78%; height: 100%; align-items: center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; padding-top: 10%; padding-right: 10%; padding-bottom: 10%; padding-left: 10%; background-color: rgb(0, 0, 112); margin-left: 0; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); display: flex;">
                <ui:VisualElement name="shopcbbleicon" style="flex-grow: 0; flex-direction: column; background-image: url(&quot;project://database/Assets/Art/MCCobblestone.png?fileID=2800000&amp;guid=842aca1794906e64eb8898b2b81fc18d&amp;type=3#MCCobblestone&quot;); height: 100px; width: 100px; justify-content: flex-start; position: relative; top: 0;" />
                <ui:Label text="Napis" name="Napis" class="text" style="height: auto; width: auto; left: auto; position: relative; top: 0%; margin-top: 0; margin-right: 0; margin-bottom: 20px; margin-left: 0;" />
                <ui:Slider label="Slider" value="0" high-value="100" name="AmoutSlider" style="background-size: 100% 100%; height: 30px; width: 100%; min-height: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
                <ui:Button text="Sprzedaj" name="sell1" class="btncolor text mariginbottom10 navbuttonborder" style="top: auto; visibility: visible; display: flex; margin-top: 10%; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Content2" style="flex-grow: 1; position: absolute; width: 78%; height: 100%; align-items: center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; padding-top: 10%; padding-right: 10%; padding-bottom: 10%; padding-left: 10%; background-color: rgb(0, 0, 112); margin-left: 0; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); display: none;">
                <ui:Button text="Dodaj fabrykę" name="addfactory" class="btncolor text mariginbottom10 navbuttonborder" style="top: auto; visibility: visible; display: flex; margin-top: 10%; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Content3" style="flex-grow: 1; position: absolute; width: 78%; height: 100%; align-items: center; align-self: flex-end; align-content: flex-start; justify-content: flex-start; padding-top: 10%; padding-right: 10%; padding-bottom: 10%; padding-left: 10%; background-color: rgb(0, 0, 112); margin-left: 0; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); display: none;">
                <ui:Label text="żelo" name="Napis2" class="text" style="height: auto; width: auto; left: auto; position: relative; top: 0%; margin-top: 0; margin-right: 0; margin-bottom: 20px; margin-left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
